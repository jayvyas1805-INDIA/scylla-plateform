# --- LLM provider (OpenAI-compatible endpoint) ---
# Recommended default: Groq, open-weight Llama 3.3 70B, free tier, fast,
# supports tool calling (needed from Phase 6 onward).
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_TEMPERATURE=0.3

# To switch providers later, change ONLY the three values above, e.g.:
#   Together AI : LLM_BASE_URL=https://api.together.xyz/v1        LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   OpenRouter  : LLM_BASE_URL=https://openrouter.ai/api/v1        LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#   Local Ollama: LLM_BASE_URL=http://localhost:11434/v1           LLM_MODEL=llama3.3   LLM_API_KEY=ollama

# --- Existing Scylla backend ---
SCYLLA_BACKEND_URL=http://localhost:5000

# MUST match the Express backend's JWT_SECRET exactly — used only to
# read caller role/id for prompt context, never to authorize data access.
JWT_SECRET=same_value_as_backend_JWT_SECRET

# --- CORS: the Client (and admin-dashboard, if it also embeds the widget) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

MAX_HISTORY_TURNS=6
ENV=development
