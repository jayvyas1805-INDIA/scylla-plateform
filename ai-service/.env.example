# --- LLM provider (OpenAI-compatible endpoint) ---
# Primary: Groq, open-weight gpt-oss-120b, free tier, supports tool calling
# (needed from Phase 6 onward). NOTE: Groq retired llama-3.3-70b-versatile on
# 2026-08-16, so do not use it here any more.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_TEMPERATURE=0.3

# --- Latency tuning (optional) ---
# Seconds to wait on a provider before failing over (streaming: max silence
# between chunks, incl. the model's thinking time before the first token).
LLM_TIMEOUT=20
# low | medium | high. Sent only to Groq gpt-oss models. "low" = faster first
# token but possibly weaker tool choice; re-run `python -m eval.run_eval`.
# LLM_REASONING_EFFORT=low

# --- Fallbacks (optional, tried in order when the primary fails) ---
# Each slot needs all three values, otherwise it is skipped. Up to 5 slots.
# Keep them tool-calling capable; the same model family as the primary
# keeps behaviour close to what the prompt/tests were tuned against.

# 1) Same Groq key, smaller model (Groq rate limits are per model)
LLM_FALLBACK_1_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_1_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_1_API_KEY=your_groq_api_key_here

# 2) NVIDIA NIM (free with NVIDIA Developer Program; trial terms, see README)
LLM_FALLBACK_2_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_FALLBACK_2_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_2_API_KEY=nvapi-your_key_here

# 3) OpenRouter free model (low daily cap unless you buy $10+ credits once)
LLM_FALLBACK_3_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_3_MODEL=openai/gpt-oss-20b:free
LLM_FALLBACK_3_API_KEY=sk-or-your_key_here

# --- Existing Scylla backend ---
SCYLLA_BACKEND_URL=http://localhost:5000

# MUST match the Express backend's JWT_SECRET exactly — used only to
# read caller role/id for prompt context, never to authorize data access.
JWT_SECRET=same_value_as_backend_JWT_SECRET

# --- CORS: the Client (and admin-dashboard, if it also embeds the widget) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

MAX_HISTORY_TURNS=6
ENV=development

# --- Document-review (RAG) endpoint ---
# Shared secret checked on the X-Internal-Secret header of
# POST /api/assistant/review-document. This endpoint is called
# server-to-server by the Express backend right after a team/vendor
# (re)uploads their verificationDoc — it is NEVER called from the
# browser, so it has no per-user JWT to check; this secret is the only
# gate. MUST match the Express backend's INTERNAL_SERVICE_SECRET exactly.
INTERNAL_SERVICE_SECRET=change_me_to_a_long_random_value
